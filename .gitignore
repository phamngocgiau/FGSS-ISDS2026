# =====================================================================
# Git ignore configuration for public GitHub research repository
# =====================================================================

# LaTeX manuscript sources and build artifacts (kept locally, hidden from git)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.tex
*.pdf

# Internal review, rebuttal, and submission workflows
Review_and_Submission/
Compiled_PDFs/
EasyChair_Submission/
build_isds2026.bat
check_submission.ps1
shrink_assets.py

# Redundant design formats (single source image kept on GitHub)
paper_assets/*.drawio
paper_assets/architecture_diagram.pdf

# Local archives and old assets
paper_assets_old/
paper_assets_fullres/
PlotNeuralNet/
*.zip

# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
env/

# System and temporary files
Thumbs.db
.DS_Store
tmp/
scratch/

# Allow public repository README
!README.md
